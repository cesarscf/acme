{
  "name": "@acme/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "db:migrate:deploy": "bun src/migrate.ts",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio",
    "check-types": "tsc",
    "test": "bun --env-file=../../.env test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@acme/typescript-config": "workspace:*",
    "@types/bun": "1.4.3",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  }
}
