# Host port for the Docker Postgres; change it (and DATABASE_URL) if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgres://acme:acme@localhost:5432/acme

# Graph API base URL with version (https://graph.facebook.com/v24.0 in production) and the token the API sends with.
META_GRAPH_URL=http://localhost:4000
META_ACCESS_TOKEN=dev-access-token

# Meta app secret (signs webhooks), webhook verify token, and where the Meta Emulator delivers webhooks.
META_APP_SECRET=dev-app-secret
META_VERIFY_TOKEN=dev-verify-token
META_WEBHOOK_URL=http://localhost:3000/webhooks/whatsapp

# The platform's own WhatsApp number and WABA, which send the login code (the emulator in M1).
META_PLATFORM_PHONE_NUMBER_ID=9001
META_PLATFORM_WABA_ID=9000

# Better Auth: secret that signs sessions (`openssl rand -base64 32`) and the API's public URL.
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-in-production
BETTER_AUTH_URL=http://localhost:3000

# Claude API key for the Assistants (console.anthropic.com). CLAUDE_MODEL overrides the default claude-haiku-5-5.
# ANTHROPIC_WORKSPACE_ID (wrkspc_…) is needed only when the key is not scoped to a workspace.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=

# OpenRouter key for transcribing the Professional's audio (openrouter.ai/settings/keys).
OPENROUTER_API_KEY=
