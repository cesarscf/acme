# Host port for the Docker Postgres; change it (and DATABASE_URL) if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgres://acme:acme@localhost:5432/acme

# Meta app secret (signs webhooks), webhook verify token, and where the Meta Emulator delivers webhooks.
META_APP_SECRET=dev-app-secret
META_VERIFY_TOKEN=dev-verify-token
META_WEBHOOK_URL=http://localhost:3000/webhooks/whatsapp
