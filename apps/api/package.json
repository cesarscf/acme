{
  "name": "@acme/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "check-types": "tsc",
    "test": "bun --env-file=../../.env test",
    "test:claude": "CLAUDE_LIVE=1 bun --env-file=../../.env test src/modules/conversations/claude.live.test.ts",
    "evals": "bun --env-file=../../.env test --concurrent --max-concurrency=5 --timeout=180000 ./src/modules/*/*.eval.ts"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@anthropic-ai/sdk": "0.134.0",
    "@better-auth/expo": "1.7.10",
    "@sinclair/typebox": "0.34.52",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "exact-mirror": "1.2.6",
    "file-type": "22.2.0",
    "openapi-types": "12.1.3",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@acme/meta-emulator": "workspace:*",
    "@acme/typescript-config": "workspace:*",
    "@elysia/eden": "1.4.10",
    "@types/bun": "1.4.3",
    "pix-utils": "2.8.2",
    "typescript": "6.0.3"
  }
}
